@page "/media"
@rendermode InteractiveServer

<PageTitle>Calculadora de Média</PageTitle>
<p class="eyebrow">Exercício 02</p>
<h1>Calculadora de Média do Aluno</h1>
<p class="intro">Informe duas notas. A média mínima para aprovação é 7,0.</p>

<section class="exercise" aria-label="Cálculo da média">
    <label for="nota1">Primeira nota</label>
    <input id="nota1" type="number" step="any" @bind="nota1" />
    <label for="nota2">Segunda nota</label>
    <input id="nota2" type="number" step="any" @bind="nota2" />
    <button type="button" @onclick="CalcularMedia">Calcular Média</button>

    <div aria-live="polite">
        @if (media.HasValue)
        {
            <p class="result">Média: @media.Value</p>
            @if (media.Value >= 7.0)
            {
                <p class="status approved" style="color: green;">Aprovado!</p>
            }
            else
            {
                <p class="status failed" style="color: red;">Reprovado!</p>
            }
        }
    </div>
</section>

@code {
    private double nota1;
    private double nota2;
    private double? media = null;

    private void CalcularMedia()
    {
        media = (nota1 + nota2) / 2;
    }
}
